In[187]:= windowedProcess[data_, extractor_, start_, end_, step_, winSize_] := 
 Module[{windowedFFTs}, 
  windowedFFTs = Table[windowData = extractor[data, t, winSize];
    If[Length[windowData] < 2, Nothing, fftResult = FFT[windowData];
     Map[{t + winSize/2, #[[1]], #[[2]]} &, fftResult]], {t, start, 
     end - winSize, step}];
  Flatten[windowedFFTs, 1]]


Grid[ListDensityPlot[windowedProcess[data, extract1, 2, 6, 0.3, 0.5], 
  FrameLabel -> {"Window Center", "Frequency (Hz)"}, 
  PlotLabel -> "Method 1: Select", ImageSize -> Large],
 
 ListDensityPlot[windowedProcess[data, extract2, 2, 6, 0.3, 0.5], 
  FrameLabel -> {"Window Center", "Frequency (Hz)"}, 
  PlotLabel -> "Method 2: Zero Masking", ImageSize -> Large],
 
