In[108]:= time\[LetterSpace]f[index_] := 
  DateObject[{2021, 11, 17, 16, 16, 30 + (index - 1)/20 }];

In[77]:= import[[2, 1]] + 1

Out[77]= 382.69

In[78]:= data[[2]]

Out[78]= 381.76

In[109]:= (*data = Map[Map[Internal`StringToDouble, StringSplit[#[[1]], Whitespace]]&, \
import[[2;;]]] ;*)
data = import[[2 ;;]][[All, 1]];
channel\[LetterSpace]data = 0.02*(data - Mean[data]);
channel\[LetterSpace]timeseria = 
  MapIndexed[{time\[LetterSpace]f[#2[[1]]], #} &, channel\[LetterSpace]data];

In[112]:= channel\[LetterSpace]timeseria[[1]]

Out[112]= {DateObject[{2021, 11, 17, 16, 16, 30}, "Instant", "Gregorian", 
  3.], -0.101551}

In[83]:= DateListPlot[channel\[LetterSpace]timeseria, AspectRatio -> 1/8, 
  ImageSize -> 2000];

In[225]:= sample\[LetterSpace]rate

Out[225]= 20

In[113]:= filtered\[LetterSpace]data = 
  BandpassFilter[
   channel\[LetterSpace]timeseria[[All, 2]], {2 \[Pi] 0.1, 2 \[Pi] 8} , 
   SampleRate -> Round[sample\[LetterSpace]rate]];
filtered\[LetterSpace]timeseria = 
  Transpose[{channel\[LetterSpace]timeseria[[All, 1]], 
    filtered\[LetterSpace]data}];

In[23]:= DateListPlot[filtered\[LetterSpace]timeseria, AspectRatio -> 1/8, 
  ImageSize -> 2000, PlotRange -> All];




filtered\[LetterSpace]timeseria\[LetterSpace]clip = 
  Select[filtered\[LetterSpace]timeseria, 
   range[[1]] <= AbsoluteTime[#[[1]]] <= range[[2]] &];
DateListPlot[filtered\[LetterSpace]timeseria\[LetterSpace]clip, 
 AspectRatio -> 1/8, ImageSize -> 2000, PlotRange -> All]

