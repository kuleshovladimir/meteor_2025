In[133]:=  ListPlot3D[processWindows[datSin, 0, 10, 0.5], ImageSize -> Large, 
 PlotRange -> {All, {0, 10}, {0, 0.2}}, 
 AxesLabel -> {"Window Center", "Frequency", "Amplitude"}]

