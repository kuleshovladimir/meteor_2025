In[125]:= dataImport = 
  Import["/Users/kuleshovladimir/Downloads/meteor_2025-main/Meteor \
Observations/2018 (2021.07.06)/records/18080723.293"];
timeFunc[index_] := DateObject[{2018, 8, 7, 23, 29, 31.358 + (index - 1)/100}];
sampleRate = 100;

rawData = 
  Map[Map[Internal`StringToMReal, StringSplit[#[[1]], Whitespace]] &, 
   dataImport[[18 ;;]]];


In[140]:= processedData = 0.02*(rawData[[All, 1]] - Mean[rawData[[All, 1]]]);
timeSeries = MapIndexed[{timeFunc[#2[[1]]], #} &, processedData];

In[144]:= filteredSignal = 
  BandpassFilter[timeSeries[[All, 2]], {2 \[Pi] 0.1, 2 \[Pi] 10}, 
   SampleRate -> Round[sampleRate]];
filteredSeries = Transpose[{timeSeries[[All, 1]], filteredSignal}];

DateListPlot[timeSeries, AspectRatio -> 1/8, ImageSize -> 2000];
DateListPlot[filteredSeries, AspectRatio -> 1/8, ImageSize -> 2000, 
  PlotRange -> All];

timeRange = {AbsoluteTime[DateObject[{2018, 8, 7, 23, 30, 0}]], 
   AbsoluteTime[DateObject[{2018, 8, 8, 00, 10, 0}]]};
clippedSeries = 
  Select[filteredSeries, 
   timeRange[[1]] <= AbsoluteTime[#[[1]]] <= timeRange[[2]] &];

DateListPlot[clippedSeries, AspectRatio -> 1/8, ImageSize -> 2000, 
 PlotRange -> All]

