In[268]:= AbsoluteTime[DateObject[{2021, 11, 17, 17, 52, 0}]]

Out[268]= 3846160320

In[279]:= filteredPar = Select[par, #[[2]] < 0.05 &]

Out[279]= {{3846159365, 0.0351209}, {3846159385, 0.0292988}, {3846159425, 
  0.0396189}, {3846160455, 0.0396799}, {3846160475, 0.0219647}}

In[427]:= filteredPar = Join[Select[par, #[[2]] < 0.025 &], param];

plots = Table[{timeID, mse} = filteredPar[[i]];
   data = Select[filteredAbsTimeFull, timeID + 5 <= #[[1]] <= timeID + 25 &];
   normalizedData = If[Length[data] > 0, timeRange = data[[All, 1]];
     normalizedTimes = 
      Rescale[timeRange, {Min[timeRange], Max[timeRange]}, {0, 10}];
     normalizedValues = data[[All, 2]]/Max[data[[All, 2]]]; 
     Transpose[{normalizedTimes, normalizedValues}], {}];
   If[Length[normalizedData] > 0, 
    ListLinePlot[normalizedData, PlotStyle -> ColorData[97][i], 
     PlotRange -> All, 
     PlotLegends -> Placed[{"ID: " <> ToString[timeID]}, Right]], 
    Nothing], {i, Length[filteredPar]}];

Show[plots, Frame -> True, 
 FrameLabel -> {"Нормализованное время", "Нормализованная амплитуда"}, 
 ImageSize -> 1000]

