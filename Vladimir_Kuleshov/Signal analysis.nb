Chapter 4

In[184]:= extract1[data_, t0_, dt_] := Select[data, t0 <= #[[1]] <= t0 + dt &]
extract2[data_, t0_, dt_] := 
 Module[{win}, win = If[t0 <= # <= t0 + dt, 1, 0] & /@ data[[All, 1]];
  Transpose@{data[[All, 1]], win*data[[All, 2]]}] (*индикаторная функция*)
extract3[data_, t0_, dt_] := 
 Module[{times, values, mask, windowFunc, indices}, times = data[[All, 1]];
  values = data[[All, 2]];
  indices = 
   Flatten@Position[Clip[times, {t0, t0 + dt}, {0, 0}], _?(# > 0 &)];
  If[Length[indices] == 0, Return[{}]];
  windowFunc = Table[0, {Length[times]}];
  windowFunc[[indices]] = 
   Table[0.5 (1 - Cos[2 Pi (i - 1)/(Length[indices] - 1)]), {i, 
     Length[indices]}];
  Transpose@{times, values*windowFunc}]



In[161]:= Grid[ListLinePlot@extract1[data, 2, 4], 
 ListLinePlot[extract2[data, 2, 4], PlotRange -> All], 
 ListLinePlot@extract3[data, 2, 4]]

