In[181]:= FFT[data0_] := 
  Module[{data = data0, fdata, n, t, fs, freq}, n = Length[data];
   t = data[[2, 1]] - data[[1, 1]];
   fs = 1/t;
   fdata = data[[All, 2]] - Mean[data[[All, 2]]];
   fdata = Abs[Fourier[fdata, FourierParameters -> {1, -1}]];
   fdata = (2/n)*fdata;
   freq = Range[0, n - 1]*fs/n;
   Transpose@{freq, fdata}];

FFTPlot[dat_] := 
  Module[{fftData, len, fs, t, maxFreq, plotData}, 
   If[Length[dat] < 2, Return[Graphics[]]];
   t = dat[[2, 1]] - dat[[1, 1]];
   fs = 1/t;
   fftData = FFT[dat];
   len = Length[fftData];
   maxFreq = fs/2;
   plotData = Select[fftData, #[[1]] <= maxFreq &];
   ListLinePlot[plotData, ImageSize -> Large, AspectRatio -> 1/2, 
    PlotStyle -> Orange, PlotRange -> All, 
    AxesLabel -> {"Частота, Гц", "Амплитуда"}]];

In[183]:= FFTPlotNorm[dat_] := 
  Module[{fftData, len, fs, t, maxFreq, plotData, maxAmp}, 
   If[Length[dat] < 2, Return[Graphics[]]];
   t = dat[[2, 1]] - dat[[1, 1]];
   fs = 1/t;
   fftData = FFT[dat];
   len = Length[fftData];
   maxFreq = fs/2;
   plotData = Select[fftData, #[[1]] <= maxFreq &];
   maxAmp = Max[plotData[[All, 2]]];
   If[maxAmp > 0, plotData[[All, 2]] = plotData[[All, 2]]/maxAmp];
   ListLinePlot[plotData, ImageSize -> Large, AspectRatio -> 1/2, 
    PlotStyle -> Orange, PlotRange -> All, 
    AxesLabel -> {"Частота, Гц", "Нормированная амплитуда"}]];

