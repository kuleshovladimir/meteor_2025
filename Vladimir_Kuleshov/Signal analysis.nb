Метрика \[Dash] среднеквадратичная ошибка

In[211]:= CalculateMSE[peaks_, refPeaks_] := 
  Module[{peaksY, refY, minLen}, peaksY = peaks[[All, 2]];
   refY = refPeaks[[All, 2]];
   minLen = Min[Length[peaksY], Length[refY]];
   If[minLen == 0, Indeterminate, 
    Mean[(peaksY[[1 ;; minLen]] - refY[[1 ;; minLen]])^2]]];

