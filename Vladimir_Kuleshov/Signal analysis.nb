In[40]:= filteredTimeseriaAbs = 
  Transpose@{AbsoluteTime /@ filtered\[LetterSpace]timeseria[[All, 1]], 
    filtered\[LetterSpace]timeseria[[All, 2]]};
ListLinePlot[filteredTimeseriaAbs, AspectRatio -> 1/8, ImageSize -> 2000, 
 PlotRange -> All, 
 AxesLabel -> {"Абсолютное время (сек с 1900 г.)", "Амплитуда"}, 
 GridLines -> Automatic]

