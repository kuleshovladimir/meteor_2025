In[206]:= FFTPeaks[dat_, opts_] := 
 Module[{x, t, fs, len, fftAmp, freqs, plotData, maxAmp, peakIndices, peaks}, 
  If[Length[dat] < 2, Return[{}]];
  x = dat[[All, 2]] - Mean[dat[[All, 2]]];
  t = dat[[2, 1]] - dat[[1, 1]];
  fs = 1/t;
  len = Length[x];
  fftAmp = Abs@Fourier[x];
  freqs = Range[0, fs, fs/len][[1 ;; Floor[len/2]]];
  fftAmp = fftAmp[[1 ;; Floor[len/2]]];
  maxAmp = Max[fftAmp];
  If[maxAmp > 0, fftAmp = fftAmp/maxAmp];
  plotData = Transpose@{freqs, fftAmp};
       peakIndices = First /@ FindPeaks[plotData[[All, 2]], opts];
       validIndices = Select[peakIndices, 1 <= # <= Length[plotData] &];
       peaks = If[Length[validIndices] > 0, plotData[[validIndices]], {}];
  {validIndices, plotData}]


In[207]:= FFTPeaks[filteredAbsTime]

