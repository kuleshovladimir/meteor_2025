ФФТ в окне

In[274]:= windowedProcessGrouped[data_, extractor_, start_, end_, step_, winSize_] := 
 Module[{windowedFFTs}, 
  windowedFFTs = Table[windowData = extractor[data, t, winSize];
    If[Length[windowData] < 2, Nothing, 
     centered = windowData[[All, 2]] - Mean[windowData[[All, 2]]];
     normed = 
      If[Max[Abs[centered]] > 0, centered/Max[Abs[centered]], centered];
     timeVector = windowData[[All, 1]];
     fftResult = Transpose@{timeVector, normed} // FFT;
     {t + winSize/2, Map[#[[{1, 2}]] &, fftResult]}], {t, start, 
     end - winSize, step}];
  windowedFFTs]



