In[437]:= plots = Table[{timeID, mse} = filteredPar[[i]];
   data = Select[filteredAbsTimeFull, timeID + 5 <= #[[1]] <= timeID + 25 &];
   normalizedData = If[Length[data] > 0, timeRange = data[[All, 1]];
     normalizedTimes = 
      Rescale[timeRange, {Min[timeRange], Max[timeRange]}, {0, 10}];
     normalizedValues = data[[All, 2]]/Max[data[[All, 2]]];
     Transpose[{normalizedTimes, normalizedValues}], {}];
   If[Length[normalizedData] > 0, 
    ListLinePlot[normalizedData, PlotStyle -> ColorData[97][i], 
     PlotRange -> All, ImageSize -> 400,(*Задаем размер каждого графика*)
     PlotLegends -> Placed[{"ID: " <> ToString[timeID]}, Right]], 
    Nothing], {i, Length[filteredPar]}];

(*Размещаем в Grid вертикально (один столбец)*)
Grid[{plots} // Transpose, Alignment -> Left, Spacings -> {0, 1}]

